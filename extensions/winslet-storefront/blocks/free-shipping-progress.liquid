{%- comment -%}
  Free-shipping progress bar — a global app embed (toggle it on once in
  Theme Editor > App embeds, no per-page placement or settings needed).

  Unlike the earlier version of this block, nothing here is hand-typed:
  the threshold and colors/messages both come live from Winslet's App
  Proxy (see apps.proxy.free-shipping.tsx and free-shipping-bar.js),
  reading whichever campaign has an active free-shipping reward and
  whatever styling the merchant set on the Storefront settings page —
  so this can never drift out of sync with the real discount the way a
  hand-typed threshold could.
{%- endcomment -%}

<script type="module" defer src="{{ 'free-shipping-bar.js' | asset_url }}"></script>
<winslet-free-shipping-bar
  data-proxy-root="/apps/winslet"
  data-currency="{{ cart.currency.iso_code }}"
></winslet-free-shipping-bar>

{% schema %}
{
  "name": "Free shipping bar",
  "target": "body"
}
{% endschema %}
